{
  "name": "trio-hmi-visualizer",
  "version": "0.2.0",
  "private": true,
  "description": "Browser HMI visualizer + headless simulator for Trio Motion controllers.",
  "license": "MIT",
  "bin": {
    "trio-sim": "tools/trio-sim.js",
    "hmi-shot": "tools/hmi-shot.js"
  },
  "scripts": {
    "test": "node tests/run-all.js",
    "sim": "node tools/trio-sim.js",
    "hmi-shot": "node tools/hmi-shot.js",
    "start": "python3 -m http.server 8000",
    "postinstall": "playwright install chromium",
    "demo": "python3 skills/trio-hmi-screens/scripts/trio_hmi.py build skills/trio-hmi-screens/assets/examples/demo-cell.json -o out/demo",
    "check:demo": "npm run demo && node skills/trio-hmi-screens/scripts/check_preview.cjs out/demo/preview.html --shots out/demo/shots"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
