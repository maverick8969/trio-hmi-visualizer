    <!-- END SHIFT / SHIFT DONE pair: two buttons stacked at the same position.
         TVBButton does not support runtime BackColor or Text binding, so two
         overlapping buttons are used instead.  ButtonShiftActive (orange) has
         its Visible bound to VR:4058 (End_Shift_Button_Visible) so it ONLY
         appears when the shift is active AND no axis is moving — an accidental
         press while producing is structurally impossible because the button is
         hidden.  ButtonShiftDone (green) has Visible bound to VR:4024 and
         covers ButtonShiftActive's slot once the shift ends.
         ButtonShiftActive no longer toggles VR 4024 directly — it writes
         Popup_Action (VR 589) = 1, which HMI_ANIMATION.shift_end_popup
         intercepts.  If product_length < 1 ft the popup is skipped and
         operator_shift_done is set immediately; otherwise the footage
         confirmation popup (VR 588 = 1) appears.  ButtonShiftDone retains
         the direct toggle so the operator can undo a shift-end without going
         through the popup. -->
    <component>
      <assembly>HMIClient</assembly>
      <type>Trio.HMI.Controls.TVBButton</type>
      <name>ButtonShiftActive</name>
      <!-- action writes Popup_Action (VR 589) = 1; HMI_ANIMATION handles threshold check -->
      <properties>
        <property>
          <name>BackColor</name>
          <type>System.Drawing.Color</type>
          <value>#FFFF8C00</value>
        </property>
        <property>
          <name>Text</name>
          <type>System.String</type>
          <value xml:space="preserve">END SHIFT</value>
        </property>
        <property>
          <name>Font</name>
          <type>System.Drawing.Font</type>
          <value xml:space="preserve">DejaVu Sans:18:1</value>
        </property>
        <property>
          <name>ForeColor</name>
          <type>System.Drawing.Color</type>
          <value>#FFFFFFFF</value>
        </property>
        <property>
          <name>Height</name>
          <type>System.Int32</type>
          <value>56</value>
        </property>
        <property>
          <name>Left</name>
          <type>System.Int32</type>
          <value>8</value>
        </property>
        <property>
          <name>Name</name>
          <type>System.String</type>
          <value>ButtonShiftActive</value>
        </property>
        <property>
          <name>Top</name>
          <type>System.Int32</type>
          <value>54</value>
        </property>
        <property>
          <name>Visible</name>
          <type>System.Boolean</type>
          <value>False</value>
          <binding>
            <mcsource>VR(4058).0</mcsource>
            <mode>ReadOnly</mode>
          </binding>
        </property>
        <property>
          <name>Width</name>
          <type>System.Int32</type>
          <value>180</value>
        </property>
        <property>
          <name>ImageSmartStretch</name>
          <type>System.Boolean</type>
          <value>True</value>
        </property>
      </properties>
      <events>
        <event>
          <name>Click</name>
